<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Mods" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:message id="Msg_Solicitud" name="Paquete compilado y solicitud de aprobación" />
  <bpmn:message id="Msg_Resultado" name="Resultado de evaluación" />
  <bpmn:error id="Error_Publicacion" name="Error de publicación" errorCode="PUB_ERR" />
  <bpmn:collaboration id="Collab_Mods">
    <bpmn:participant id="Pool_Larian" name="LARIAN STUDIOS" processRef="Proc_Larian" />
    <bpmn:participant id="Pool_Sony" name="SONY / MICROSOFT" processRef="Proc_Sony" />
    <bpmn:messageFlow id="MF_01" name="Paquete compilado + solicitud de aprobación" sourceRef="Task_Solicitar" targetRef="Start_Sony" messageRef="Msg_Solicitud" />
    <bpmn:messageFlow id="MF_02" name="Resultado de evaluación" sourceRef="Task_Enviar" targetRef="Catch_Resp" messageRef="Msg_Resultado" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_Larian" name="Proceso Larian" isExecutable="false">
    <bpmn:laneSet id="LaneSet_L">
      <bpmn:lane id="Lane_Modder" name="Modder">
        <bpmn:flowNodeRef>Start_Mod</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Subir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_IA" name="Sistema_IA">
        <bpmn:flowNodeRef>Task_Procesar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_IA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Ticket</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ErrIA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Compilar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_QA" name="Ingeniero_QA">
        <bpmn:flowNodeRef>Task_QA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_QA</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Legal" name="Equipo_Legal">
        <bpmn:flowNodeRef>Task_Solicitar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Resp</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Consola</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OK</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ErrRechazo</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Mod" name="Mod listo para publicar">
      <bpmn:outgoing>SF_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Subir" name="Subir mod">
      <bpmn:incoming>SF_01</bpmn:incoming>
      <bpmn:outgoing>SF_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_Procesar" name="Procesar y traducir código">
      <bpmn:incoming>SF_02</bpmn:incoming>
      <bpmn:outgoing>SF_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="GW_IA" name="¿Validación IA exitosa?">
      <bpmn:incoming>SF_03</bpmn:incoming>
      <bpmn:outgoing>SF_04</bpmn:outgoing>
      <bpmn:outgoing>SF_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Ticket" name="Generar ticket de soporte">
      <bpmn:incoming>SF_04</bpmn:incoming>
      <bpmn:incoming>SF_08</bpmn:incoming>
      <bpmn:outgoing>SF_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_ErrIA" name="Fin de error: Mod no aprobado">
      <bpmn:incoming>SF_06</bpmn:incoming>
      <bpmn:errorEventDefinition id="End_ErrIA_ed" errorRef="Error_Publicacion" />
    </bpmn:endEvent>
    <bpmn:userTask id="Task_QA" name="Revisar y aprobar QA">
      <bpmn:incoming>SF_05</bpmn:incoming>
      <bpmn:outgoing>SF_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="GW_QA" name="¿Aprobado por QA?">
      <bpmn:incoming>SF_07</bpmn:incoming>
      <bpmn:outgoing>SF_08</bpmn:outgoing>
      <bpmn:outgoing>SF_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Compilar" name="Compilar paquete sanitizado">
      <bpmn:incoming>SF_09</bpmn:incoming>
      <bpmn:outgoing>SF_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_Solicitar" name="Solicitar aprobación a Consola">
      <bpmn:incoming>SF_10</bpmn:incoming>
      <bpmn:outgoing>SF_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Catch_Resp" name="Esperando respuesta de Consola">
      <bpmn:incoming>SF_11</bpmn:incoming>
      <bpmn:outgoing>SF_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Catch_Resp_ed" messageRef="Msg_Resultado" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="GW_Consola" name="¿Aprobado por Consola?">
      <bpmn:incoming>SF_12</bpmn:incoming>
      <bpmn:outgoing>SF_13</bpmn:outgoing>
      <bpmn:outgoing>SF_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="End_OK" name="Fin éxito: Mod aprobado">
      <bpmn:incoming>SF_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_Notificar" name="Notificar rechazo al modder">
      <bpmn:incoming>SF_14</bpmn:incoming>
      <bpmn:outgoing>SF_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_ErrRechazo" name="Fin de error: Rechazo de Consola">
      <bpmn:incoming>SF_15</bpmn:incoming>
      <bpmn:errorEventDefinition id="End_ErrRechazo_ed" errorRef="Error_Publicacion" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_01" sourceRef="Start_Mod" targetRef="Task_Subir" />
    <bpmn:sequenceFlow id="SF_02" sourceRef="Task_Subir" targetRef="Task_Procesar" />
    <bpmn:sequenceFlow id="SF_03" sourceRef="Task_Procesar" targetRef="GW_IA" />
    <bpmn:sequenceFlow id="SF_04" name="No" sourceRef="GW_IA" targetRef="Task_Ticket" />
    <bpmn:sequenceFlow id="SF_05" name="Sí" sourceRef="GW_IA" targetRef="Task_QA" />
    <bpmn:sequenceFlow id="SF_06" sourceRef="Task_Ticket" targetRef="End_ErrIA" />
    <bpmn:sequenceFlow id="SF_07" sourceRef="Task_QA" targetRef="GW_QA" />
    <bpmn:sequenceFlow id="SF_08" name="No" sourceRef="GW_QA" targetRef="Task_Ticket" />
    <bpmn:sequenceFlow id="SF_09" name="Sí" sourceRef="GW_QA" targetRef="Task_Compilar" />
    <bpmn:sequenceFlow id="SF_10" sourceRef="Task_Compilar" targetRef="Task_Solicitar" />
    <bpmn:sequenceFlow id="SF_11" sourceRef="Task_Solicitar" targetRef="Catch_Resp" />
    <bpmn:sequenceFlow id="SF_12" sourceRef="Catch_Resp" targetRef="GW_Consola" />
    <bpmn:sequenceFlow id="SF_13" name="Sí" sourceRef="GW_Consola" targetRef="End_OK" />
    <bpmn:sequenceFlow id="SF_14" name="No" sourceRef="GW_Consola" targetRef="Task_Notificar" />
    <bpmn:sequenceFlow id="SF_15" sourceRef="Task_Notificar" targetRef="End_ErrRechazo" />
  </bpmn:process>
  <bpmn:process id="Proc_Sony" name="Proceso Sony / Microsoft" isExecutable="false">
    <bpmn:laneSet id="LaneSet_S">
      <bpmn:lane id="Lane_Consola" name="Consola">
        <bpmn:flowNodeRef>Start_Sony</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Evaluar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Enviar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_Sony</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Publicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_OKSony</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_ErrSony</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Sony" name="Solicitud recibida">
      <bpmn:outgoing>SF_16</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Sony_ed" messageRef="Msg_Solicitud" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_Evaluar" name="Evaluar paquete compilado">
      <bpmn:incoming>SF_16</bpmn:incoming>
      <bpmn:outgoing>SF_17</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_Enviar" name="Enviar resultado de evaluación">
      <bpmn:incoming>SF_17</bpmn:incoming>
      <bpmn:outgoing>SF_18</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:exclusiveGateway id="GW_Sony" name="¿Aprobado por Consola?">
      <bpmn:incoming>SF_18</bpmn:incoming>
      <bpmn:outgoing>SF_19</bpmn:outgoing>
      <bpmn:outgoing>SF_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Publicar" name="Publicar en tiendas digitales">
      <bpmn:incoming>SF_19</bpmn:incoming>
      <bpmn:outgoing>SF_20</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_OKSony" name="Fin éxito: Mod publicado">
      <bpmn:incoming>SF_20</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_ErrSony" name="Fin de error: Mod rechazado por Consola">
      <bpmn:incoming>SF_21</bpmn:incoming>
      <bpmn:errorEventDefinition id="End_ErrSony_ed" errorRef="Error_Publicacion" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="SF_16" sourceRef="Start_Sony" targetRef="Task_Evaluar" />
    <bpmn:sequenceFlow id="SF_17" sourceRef="Task_Evaluar" targetRef="Task_Enviar" />
    <bpmn:sequenceFlow id="SF_18" sourceRef="Task_Enviar" targetRef="GW_Sony" />
    <bpmn:sequenceFlow id="SF_19" name="Sí" sourceRef="GW_Sony" targetRef="Task_Publicar" />
    <bpmn:sequenceFlow id="SF_20" sourceRef="Task_Publicar" targetRef="End_OKSony" />
    <bpmn:sequenceFlow id="SF_21" name="No" sourceRef="GW_Sony" targetRef="End_ErrSony" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_Mods">
    <bpmndi:BPMNPlane id="Plane_Mods" bpmnElement="Collab_Mods">
      <bpmndi:BPMNShape id="Pool_Larian_di" bpmnElement="Pool_Larian" isHorizontal="true">
